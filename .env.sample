# Copy this file to .env in the repository root, then add your own keys.
# .env is ignored by Git. Keep credentials out of this sample file.

# Use the Gemini Developer API with an API key (not Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Required for live chat. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Bhalu & Bhediya model. Change this to another Gemini model if needed.
GEMINI_MODEL=gemini-3.8-flash

# Optional: live web search from https://dashboard.exa.ai/api-keys
# Leave blank to chat using the curated Bhalu & Bhediya notes.
EXA_API_KEY=
